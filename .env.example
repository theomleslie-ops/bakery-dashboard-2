# Bakery Dashboard - Environment Configuration

# Server
PORT=3001

# Composio Integration (replaces direct API keys)
# Get your API key from: https://composio.dev
COMPOSIO_API_KEY=your_api_key_here
USER_ID=your_email@example.com

# Note: Direct API keys are no longer needed!
# The following are deprecated and should be removed:
# - SQUARE_ACCESS_TOKEN
# - SQUARE_LOCATION_ID
# - QUICKBOOKS_CLIENT_ID
# - QUICKBOOKS_CLIENT_SECRET
# - QUICKBOOKS_REDIRECT_URI
# - QUICKBOOKS_ENVIRONMENT

# Third-party Integrations (still needed for other features)
GH_TOKEN=your_github_token_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
